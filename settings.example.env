# Copy this file to .env for local use. Set real secrets only in .env or the host environment.
# On Vercel, connect Neon and set DATABASE_URL in the project environment settings.
DATABASE_URL=
# Generate a real SESSION_SECRET with: openssl rand -base64 32
SESSION_SECRET=
# Uncomment and replace both example accounts before signing in.
ADMIN_USERS=admin@cogniload.dev:admin332547
RESEARCHER_USERS=demo1@cogniload.dev:Demo1234!,demo2@cogniload.dev:Demo1234!
REGISTRATION_ENABLED=false

# Server defaults. An admin can override these from Admin → Study settings.
STUDY_BASELINE_SECONDS=30
STUDY_POST_TASK_SECONDS=30
STUDY_MAX_TASK_SECONDS=540
STUDY_DEFAULT_TASK_SECONDS=60
STUDY_PROTOCOL_VERSION=alz_web_games_v1
