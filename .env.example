# Session secret for signing cookies (required on Vercel)
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Demo users (format: email:password,email:password)
# Comma-separated; password must not contain "," (":" is allowed)
DEMO_USERS=demo1@cogniload.dev:Demo1234!,demo2@cogniload.dev:Demo1234!
